generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ProductStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

enum GenerationType {
  ANALYZE
  DESCRIPTION
  HASHTAGS
  IMAGE_PROCESS
  IMAGE_GENERATE
  COMMERCIAL_CONTENT
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  PAYPAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum TransactionType {
  EARN
  SPEND
  REFUND
  ADMIN_ADD
  ADMIN_REMOVE
}

enum PlanName {
  FREE
  BASIC
  PRO
  BUSINESS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  role         UserRole @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products          Product[]
  aiGenerations     AiGeneration[]
  creditWallet      CreditWallet?
  creditTransactions CreditTransaction[]
  payments          Payment[]
  subscriptions     Subscription[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  title       String?
  description String?       @db.Text
  category    String?
  brand       String?
  price       Decimal?      @db.Decimal(10,2)
  currency    String?       @default("EUR")
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  aiGenerations AiGeneration[]

  @@index([userId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  originalUrl  String   @map("original_url")
  processedUrl String?  @map("processed_url")
  thumbnailUrl String?  @map("thumbnail_url")
  type         String   @default("ORIGINAL") // ORIGINAL, PROCESSED, THUMBNAIL
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model AiGeneration {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  productId     String?          @map("product_id")
  generationType GenerationType  @map("generation_type")
  creditsUsed   Int              @map("credits_used")
  status        GenerationStatus @default(PENDING)
  inputData     Json?            @map("input_data")
  outputData    Json?            @map("output_data")
  errorMessage  String?          @map("error_message") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@map("ai_generations")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}

model CreditTransaction {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  amount    Int // positivo = gana, negativo = gasta
  type      TransactionType
  reference String? // id de AiGeneration, Payment, etc para idempotencia
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reference])
  @@map("credit_transactions")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  provider          PaymentProvider
  externalPaymentId String        @unique @map("external_payment_id") // idempotencia PayPal
  amount            Decimal       @db.Decimal(10,2)
  currency          String        @default("EUR")
  status            PaymentStatus
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  provider  PaymentProvider
  externalId String            @unique @map("external_id")
  plan      PlanName
  status    SubscriptionStatus
  startedAt DateTime           @map("started_at")
  expiresAt DateTime?          @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}